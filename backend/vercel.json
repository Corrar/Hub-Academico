{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m compileall -q app index.py",
  "outputDirectory": null,
  "functions": {
    "index.py": {
      "excludeFiles": "{tests/**,.venv/**,**/*.db,**/*.sqlite*,.env,.env.*,requirements-dev.lock}"
    }
  }
}
