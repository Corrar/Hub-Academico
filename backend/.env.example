APP_ENV=development
DATABASE_URL=sqlite:///./hub.db
# Para PostgreSQL local, use credenciais próprias:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/hub_academico

# Painel no mesmo servidor. Lista exata; não use curingas.
WEB_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Quando o painel for hospedado em outro domínio, use a URL HTTPS do front-end.
# WEB_APP_URL=https://app-fatec.vercel.app
# WEB_COOKIE_SAMESITE=none  # somente para front-end sem proxy; exige Secure=true
# Somente no desenvolvimento HTTP em loopback. O padrão sem esta variável é true.
# Em qualquer ambiente com HTTPS, mantenha true. Isto não libera produção.
WEB_SECURE_COOKIE=false
