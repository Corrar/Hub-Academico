APP_ENV=staging
STAGING_SYNTHETIC_DATA_ONLY=true
# Dedicated test database. Obtain the actual URL from its provider, never commit it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/hub_staging?sslmode=verify-full&sslrootcert=system
WEB_SECURE_COOKIE=true
WEB_ORIGINS=https://YOUR-PREVIEW-DOMAIN.vercel.app
# Generate a random secret of at least 32 characters. No preset credential.
STAGING_ACCESS_PASSWORD=
