APP_ENV=staging
STAGING_SYNTHETIC_DATA_ONLY=true
# Dedicated test database. Obtain the actual URL from its provider, never commit it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/hub_staging?sslmode=verify-full&sslrootcert=system
WEB_SECURE_COOKIE=true
WEB_ORIGINS=https://YOUR-PREVIEW-DOMAIN.vercel.app
# Generate a random secret of at least 32 characters. No preset credential.
STAGING_ACCESS_PASSWORD=

# Fill all five together after the institution registers the application.
# Enabling Microsoft disables local password login.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_AUTH_CONTEXT=

# Push notifications: generate with `python -m app.cli vapid-keys`; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:SUPPORT_ADDRESS@fatec.sp.gov.br
PUSH_DISPATCH_INTERVAL_SECONDS=60
# Optional external trigger (GitHub Actions, cron); at least 32 random characters.
NOTIFICATION_DISPATCH_TOKEN=

# Antivirus (clamd). When set, every upload is scanned and refused if the scanner is down.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=true

# Privacy contact shown to users (DPO/encarregado channel) and notification history retention.
# PRIVACY_CONTACT=
# NOTIFICATION_RETENTION_DAYS=90
